#!/bin/sh
# Dev launcher wrapper — makes LD_LIBRARY_PATH available so the daemon can find
# libwayland, libxkbcommon, vulkan-loader (and libglvnd) without a full
# `nix develop` shell.
#
# The paths are RESOLVED FROM THE FLAKE at launch, never hardcoded: a previous
# version froze the store paths from flake.lock, and a nixpkgs bump + GC then
# reclaimed them, so the daemon lost its GPU surface and the dock/OPTIONS shell
# vanished after a rebuild (2026-09-03). Deriving them each start is self-healing
# — the flake (flake.lock) is the single source of truth and GC can never
# desync us from it.
#
# ...but resolving means EVAL, and eval can need the network: on 2026-09-15 the
# daily nix-gc swept the (unrooted) devshell closure and the nixpkgs source
# tree, and the next boot ran us 3 s in — before the link was up — so the
# resolve came back empty and the shell started invisible (no vulkan-loader →
# no wgpu surface). Hence belt and braces: the resolve goes through a PROFILE
# (a GC root — the devshell closure can no longer be swept) and the resolved
# string is cached; a failed resolve falls back to the cache, whose paths the
# profile keeps alive. The flake stays the source of truth — every successful
# resolve refreshes both, and stale profile generations are pruned so old
# closures don't pile up on disk.
#
# ...and a resolve that needs the network can also HANG: on 2026-10-06 the
# dev box came up without a shell for ten minutes — the daemon's download of
# one small path, started 3 s after login with the link still coming up,
# stalled, and nix's stalled-download timeout is five minutes (then retries).
# The cache exists for exactly this case, so neither nix call below may hold
# the shell longer than a few seconds: past that, the cache serves.
STATE="$HOME/.local/state/waverunner"
mkdir -p "$STATE"
WAIT=25
LDP="$(timeout $WAIT nix develop --profile "$STATE/devshell" /home/max/launcher \
        --command sh -c 'printf %s "$LD_LIBRARY_PATH"' 2>/dev/null)"
if [ -n "$LDP" ]; then
  printf %s "$LDP" > "$STATE/ld-library-path"
  nix profile wipe-history --profile "$STATE/devshell" >/dev/null 2>&1
else
  LDP="$(cat "$STATE/ld-library-path" 2>/dev/null)"
  [ -n "$LDP" ] && echo "waverunner-dev: flake resolve failed (offline boot?);" \
                        "using the cached, profile-rooted env." >&2
fi
if [ -n "$LDP" ]; then
  export LD_LIBRARY_PATH="$LDP${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
  echo "waverunner-dev: WARNING: could not resolve LD_LIBRARY_PATH from the flake;" \
       "the daemon may fail to create a GPU surface." >&2
fi

# Point the clipboard dictionary panel at the flake-built, declaratively-pinned
# data (English Webster + Spanish RAE). Built + cached by Nix and ROOTED via the
# out-link (same GC lesson as above); if the build fails (offline boot) the
# out-link from the last success still serves, and only with neither does the
# daemon fall back to ~/.local/share/waverunner/.
DICTS="$(timeout $WAIT nix build --out-link "$STATE/dictionaries" --print-out-paths /home/max/launcher#dictionaries 2>/dev/null)"
[ -z "$DICTS" ] && [ -e "$STATE/dictionaries" ] && DICTS="$STATE/dictionaries"
if [ -n "$DICTS" ]; then
  export WAVERUNNER_DICT="$DICTS/share/waverunner/dictionary.json"
  export WAVERUNNER_DICT_ES="$DICTS/share/waverunner/dictionary-es.json"
fi

# The card's talk-to-text: the speech engine and its model, built by the flake
# and ROOTED via the out-link exactly as the dictionaries are (a clean-up can
# never take them; an offline boot serves the last build). Without either the
# daemon says so when the talk button is pressed.
SPEECH="$(timeout $WAIT nix build --out-link "$STATE/speech" --print-out-paths /home/max/launcher#speech 2>/dev/null)"
[ -z "$SPEECH" ] && [ -e "$STATE/speech" ] && SPEECH="$STATE/speech"
if [ -n "$SPEECH" ]; then
  export WAVERUNNER_WHISPER="$SPEECH/bin/whisper-cli"
  export WAVERUNNER_WHISPER_MODEL="$SPEECH/share/waverunner/ggml-base.bin"
fi

# Which build to run: release by default — Hyprland runs this at login, and a
# debug default once brought the desk up on a stale debug binary after a
# reboot (2026-09-30). Set WAVERUNNER_PROFILE=debug for the dev loop (verify-ui
# does). It is not a micro-optimisation: the engine's collectors parse a
# ~290 KB `pw-dump` per read, and unoptimised serde makes that cost roughly an
# order of magnitude more CPU — which on a laptop is battery.
PROFILE="${WAVERUNNER_PROFILE:-release}"
BIN="/home/max/launcher/target/$PROFILE/waverunner"
if [ ! -x "$BIN" ]; then
  [ "$PROFILE" = release ] && FLAG=" --release" || FLAG=""
  echo "waverunner-dev: no $PROFILE build at $BIN; run: nix develop -c cargo build$FLAG" >&2
  exit 1
fi
exec "$BIN" "$@"
