# Unicode CLDR's Spanish emoji annotations -> the daemon's emoji words (see gen-emoji-words.sh).
# Inputs (--slurpfile): gem = gemoji's db/emoji.json (which emoji the picker has);
# es, esd, l, ld = CLDR annotations + annotationsDerived for es and es-419.
def strip: gsub("️"; "");
def notes($a): ($a.annotations.annotations // $a.annotationsDerived.annotations);
def once: reduce .[] as $w ([]; if index([$w]) then . else . + [$w] end);
(reduce ([notes($es[0]), notes($esd[0]), notes($l[0]), notes($ld[0])][] | to_entries[]) as $e ({};
    .[$e.key | strip] += (($e.value.tts // []) + ($e.value.default // []) | map(ascii_downcase)))) as $all
| ($gem[0] | map(.emoji | strip) | unique) as $want
| "//! The emoji's words in another language — GENERATED, do not edit by hand.",
  "//!",
  "//! Source: Unicode CLDR " + $cldr + " annotations and derived annotations for `es` and",
  "//! `es-419` (Unicode License v3), for the emoji gemoji's table has; regenerated by",
  "//! `tools/gen-emoji/gen-emoji-words.sh`. Each emoji's name and keywords, Spain's and",
  "//! Latin America's, keyed by the emoji WITHOUT U+FE0F and sorted (found by halves).",
  "",
  "/// Spanish: what an emoji is called and the words it goes by.",
  "pub(crate) static ES: &[(&str, &str)] = &[",
  ($want[] | select($all[.] != null) | . as $k | "    (" + ($k | @json) + ", " + ($all[$k] | once | join(" ") | @json) + "),"),
  "];"
